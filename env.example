BOT_TOKEN=replace_with_BotFather_token
DATABASE_URL=postgresql://user:password@host:5432/database
OWNER_IDS=123456789
TIMEZONE=Europe/Paris
SUPPORT_CONTACT=@your_support
# Local development only: DATABASE_URL=sqlite:///development.db

# Optional self-hosted Bot API. Keep default unless this server is installed.
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# Shared directory, identical absolute path in the bot and API containers.
# TELEGRAM_LOCAL_FILES_ROOT=/var/lib/telegram-bot-api
# MAX_MEDIA_MB=200 (custom server only; standard Telegram remains 20 MB)
